{
  "name": "byheaven-bilingual-head",
  "version": "1.0.0",
  "description": "BYHEAVEN bilingual head injector: language detection/redirect/persistence (beforeDOMReady, in <head>) and the shared language-state / recent-notes client script (afterDOMReady).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup"
  },
  "quartz": {
    "name": "byheaven-bilingual-head",
    "displayName": "BYHEAVEN Bilingual Head",
    "category": [
      "transformer"
    ],
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 1,
    "defaultEnabled": true,
    "defaultOptions": {}
  },
  "dependencies": {
    "@quartz-community/types": "github:quartz-community/types"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
